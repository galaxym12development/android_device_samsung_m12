android_app {
    name: "SamsungParts",

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],

    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,

    static_libs: [
        "SettingsLib",
        "androidx.preference_preference",
    ],

    optimize: {
        enabled: false,
    },
}
