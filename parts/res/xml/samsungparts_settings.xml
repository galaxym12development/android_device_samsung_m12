<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/app_title">

    <PreferenceCategory
        android:key="display"
        android:title="@string/display_category">

        <ListPreference
            android:key="refresh_rate"
            android:title="@string/refresh_rate_title"
            android:icon="@drawable/ic_refresh_rate"
            android:entries="@array/refresh_rate_entries"
            android:entryValues="@array/refresh_rate_values"
            android:persistent="false"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>
</PreferenceScreen>
